# Copy to .env (or export in your shell). Secrets belong in the environment or the
# macOS Keychain, never in the database or the Markdown vault.

# Where the SQLite database lives. Default: ~/Library/Application Support/Resona on macOS,
# ~/.resona elsewhere.
# RESONA_DATA_DIR=

# Markdown vault (Obsidian-compatible). Point this at a folder inside your Obsidian vault
# to browse people, projects and interactions there. Default: $RESONA_DATA_DIR/vault
# RESONA_VAULT_DIR=

# HTTP server. Binds to loopback only and rejects non-local Host headers and unknown
# browser origins. Set RESONA_API_TOKEN to also require a bearer token.
# RESONA_HOST=127.0.0.1
# RESONA_PORT=4317
# Comma-separated browser origins allowed to call the API (e.g. the app's webview dev server)
# RESONA_ALLOWED_ORIGINS=http://localhost:5173
# Optional bearer token the app must send on every request
# RESONA_API_TOKEN=

# Claude API. Without credentials the backend falls back to offline extractive
# summaries and template drafts.
# ANTHROPIC_API_KEY=
# RESONA_MODEL=claude-opus-5-5
# RESONA_AI_EFFORT=medium

# Optional discovery connectors (read-only search).
# GITHUB_TOKEN=
# X_BEARER_TOKEN=

# Scheduler (set to 0 to disable background jobs, e.g. in tests)
# RESONA_SCHEDULER=1
# RESONA_WATCH=1
